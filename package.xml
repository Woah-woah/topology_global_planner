<?xml version="1.0"?>
<package format="3">
  <name>topology_global_planner</name>
  <version>0.2.0</version>
  <description>Weak-constraint Region-Connector topology wrapper planner for Nav2. It performs topology search before delegating each segment to an inner Nav2 global planner.</description>
  <maintainer email="todo@example.com">origin_nav</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>pluginlib</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>yaml-cpp</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/topology_global_planner_plugin.xml"/>
  </export>
</package>
